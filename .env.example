# Cookies from a logged-in x.com session (DevTools > Application > Cookies).
# auth_token is httpOnly, so it can't be read from document.cookie.
# stdio reads these. HTTP mode does not: it uses the bearer cookie pair, or
# the MySQL session when Authorization is the app token below.
X_AUTH_TOKEN=
X_CT0=
# Set to run as a Streamable HTTP server instead of stdio.
# APP_PORT=3000
# APP_HOST=127.0.0.1
# mysql://mcp_x_app:<password>@10.0.0.153:3306/mcp_x
# X_DATABASE_URL=
# App gate for the stored session. Not the X cookies. No ':' in the value.
# X_HTTP_TOKEN=
